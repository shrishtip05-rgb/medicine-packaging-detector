# Copy to .env and configure locally. Never put real credentials in this file.
FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicine_packaging_db
DB_USER=
DB_PASSWORD=

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=8388608

# Optional. Leave blank to use "tesseract" from PATH.
TESSERACT_CMD=
OCR_MAX_PIXELS=25000000
OCR_MIN_CONFIDENCE=80

# Heuristic upload quality checks (not OCR accuracy guarantees).
IMAGE_BLUR_VARIANCE_MIN=80
IMAGE_DARK_MEAN_MAX=45
IMAGE_BRIGHT_MEAN_MIN=220
IMAGE_MIN_WIDTH=640
IMAGE_MIN_HEIGHT=480
IMAGE_MAX_TILT_DEGREES=12
